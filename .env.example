# Local development only. Never commit production secrets.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://lexa:lexa@localhost:5432/lexa
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=lexa
JWT_AUDIENCE=lexa-web
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:3000

# Neon Phase 1: use the restricted application role so PostgreSQL RLS is effective.
DATABASE_APP_ROLE=lexa_app
DATABASE_LOGIN_ROLE=lexa_runtime_login_p3
LEXA_NEON_PROJECT_ID=wispy-mud-75323042
LEXA_NEON_BRANCH_ID=br-soft-star-b1dj2m2w

# Phase 3 account recovery. Configure these in Render; keep secrets out of Vercel client variables.
RESEND_API_KEY=re_replace_me
# Generate a random value with at least 32 characters; set the same secret in Vercel (server-only) and Render.
LEXA_PROXY_SHARED_SECRET=replace-with-a-random-32-character-or-longer-secret
EMAIL_FROM=LEXA Security <security@example.com>
PUBLIC_APP_URL=https://lexa-green.vercel.app
PASSWORD_RESET_MINUTES=20
EMAIL_TIMEOUT_SECONDS=8

# Next.js same-origin proxy. Local Compose uses the internal edge-lb service instead.
LEXA_API_URL=http://127.0.0.1:8000

# AI provider keys are backend-only. Leave blank to disable that provider. Never use NEXT_PUBLIC_* for keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
CEREBRAS_API_KEY=
CEREBRAS_MODEL=zai-glm-4.7
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=Qwen/Qwen3-32B
LEXA_AI_REQUESTS_PER_MINUTE=10
LEXA_AI_MAX_INPUT_CHARS=8000
LEXA_AI_MAX_OUTPUT_TOKENS=500
