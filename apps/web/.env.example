# Server-only API origin used by the same-origin Next.js proxy.
# Local development defaults to http://127.0.0.1:8000 in code when omitted.
# Configure a dedicated API origin for each Vercel environment. Never use NEXT_PUBLIC_API_URL.
LEXA_API_URL=http://127.0.0.1:8000

# Server-only; configure the same random value in Vercel and Render (32+ chars).
# Generate locally with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# LEXA_PROXY_SHARED_SECRET=replace-with-a-long-random-secret
