
name: LEXA CI

on:
  push:
    branches:
      - '**'
  pull_request:
    branches:
      - main
  workflow_dispatch:
    inputs:
      run_phase345_staging_e2e:
        description: Run write-enabled Phase 3–5 acceptance only against configured disposable staging
        type: boolean
        required: true
        default: false
      run_phase6_staging_e2e:
        description: Run write-enabled Phase 6 acceptance only against configured disposable staging
        type: boolean
        required: true
        default: false
      run_phase7_staging_e2e:
        description: Run write-enabled Phase 7 acceptance only against configured disposable staging
        type: boolean
        required: true
        default: false
        
